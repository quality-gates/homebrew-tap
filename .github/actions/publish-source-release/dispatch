#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 4 ]]; then
  echo "usage: $0 TOOL TAG RELEASE_ID SOURCE_SHA" >&2
  exit 64
fi

tool="$1"
tag="$2"
release_id="$3"
source_sha="$4"
tap_repository="quality-gates/homebrew-tap"
tap_sha="$(gh api "repos/$tap_repository/git/ref/heads/main" --jq .object.sha)"
request_id="$(python3 -c 'import uuid; print(uuid.uuid4())')"
run_title="Publish $tool $tag $request_id"
[[ "$tap_sha" =~ ^[0-9a-f]{40}$ ]]

gh api --method POST \
  "repos/$tap_repository/actions/workflows/publish-formula.yml/dispatches" \
  -f ref=main \
  -f "inputs[tool]=$tool" \
  -f "inputs[tag]=$tag" \
  -f "inputs[release_id]=$release_id" \
  -f "inputs[source_sha]=$source_sha" \
  -f "inputs[request_id]=$request_id"

run_id=""
run_url=""
for _attempt in {1..20}; do
  runs="$(gh api --method GET \
    "repos/$tap_repository/actions/workflows/publish-formula.yml/runs" \
    -f event=workflow_dispatch -f branch=main -F per_page=30)"
  run_id="$(jq -r --arg title "$run_title" --arg sha "$tap_sha" \
    '.workflow_runs[] | select(.display_title == $title and .head_sha == $sha) | .id' \
    <<<"$runs" | head -n 1)"
  run_url="$(jq -r --arg title "$run_title" --arg sha "$tap_sha" \
    '.workflow_runs[] | select(.display_title == $title and .head_sha == $sha) | .html_url' \
    <<<"$runs" | head -n 1)"
  [[ "$run_id" =~ ^[0-9]+$ ]] && break
  sleep 3
done
if [[ ! "$run_id" =~ ^[0-9]+$ || "$run_url" != "https://github.com/$tap_repository/actions/runs/"* ]]; then
  echo "The dispatched tap workflow run was not found." >&2
  exit 1
fi

echo "Tap publication: $run_url" >> "$GITHUB_STEP_SUMMARY"
gh run watch "$run_id" --repo "$tap_repository" --exit-status

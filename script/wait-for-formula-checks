#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 PR_URL" >&2
  exit 64
fi

pr_url="$1"
max_attempts="${WAIT_FOR_CHECKS_ATTEMPTS:-240}"
interval="${WAIT_FOR_CHECKS_INTERVAL:-15}"

output="$(mktemp)"
trap 'rm -f "$output"' EXIT
for (( attempt=1; attempt<=max_attempts; attempt++ )); do
  if gh pr checks "$pr_url" --watch --fail-fast --interval "$interval" >"$output" 2>&1; then
    cat "$output"
    exit 0
  else
    result=$?
  fi
  cat "$output" >&2
  # A branch update can temporarily remove its check runs.
  if ! grep -Fq 'no checks reported on' "$output"; then
    exit "$result"
  fi
  sleep "$interval"
done

echo "No formula checks were registered for $pr_url." >&2
exit 1
